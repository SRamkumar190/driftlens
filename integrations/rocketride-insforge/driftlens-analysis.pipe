{
  "components": [
    {
      "id": "driftlens_webhook",
      "provider": "webhook",
      "name": "Webhook",
      "config": {
        "hideForm": true,
        "mode": "Source",
        "parameters": {},
        "type": "webhook"
      },
      "ui": {
        "position": { "x": 0, "y": 0 },
        "nodeType": "default",
        "formDataValid": true
      }
    },
    {
      "id": "analysis_request",
      "provider": "question",
      "name": "Question",
      "config": {
        "parameters": {},
        "type": "question"
      },
      "ui": {
        "position": { "x": 220, "y": 0 },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        { "lane": "text", "from": "driftlens_webhook" }
      ]
    },
    {
      "id": "driftlens_analyze",
      "provider": "agent_rocketride",
      "name": "DriftLens Analyzer",
      "config": {
        "agent_description": "Retrieves HydraDB evidence and returns the frontend components array for DriftLens.",
        "max_waves": 4,
        "parameters": {},
        "instructions": [
          "Parse the incoming JSON. Accept only source_mode all_sources or github_only. Analyze exactly controller_01 and occlusion_sensor_01.",
          "Call hydradb_driftlens.recall_memory twice only (max_results 10 each): once for controller_01 and once for occlusion_sensor_01. Query Drive reviewed values, Slack discussion, Linear assessment/verification, and GitHub implementation values. Do not invent evidence.",
          "For github_only keep only provider github evidence and set reviewed_value, drive_evidence, slack_evidence, linear_evidence to null.",
          "Classify with these exact rules for each component: if source_mode github_only or reviewed_value/implemented_value missing => insufficient_evidence confidence 0.19; else if reviewed equals implemented => matches_design confidence 0.90; else if discussion and formal assessment exist and verification incomplete => verification_incomplete confidence 0.92; else if github evidence exists and no approved change => unreviewed_drift confidence 0.96; else insufficient_evidence confidence 0.19.",
          "Use display names Main Controller and Occlusion Sensor.",
          "Final answer MUST be ONLY a JSON array of two objects with keys: component_id, component_name, status, reviewed_value, implemented_value, confidence, drive_evidence, slack_evidence, linear_evidence, github_evidence, conclusion, recommended_action. No wrapper object. No Markdown."
        ]
      },
      "ui": {
        "position": { "x": 460, "y": 0 },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        { "lane": "questions", "from": "analysis_request" }
      ]
    },
    {
      "id": "shared_llm",
      "provider": "llm_openai",
      "name": "OpenAI",
      "config": {
        "profile": "openai-4o-mini",
        "openai-4o-mini": {
          "apikey": "${ROCKETRIDE_OPENAI_KEY}"
        },
        "parameters": {}
      },
      "ui": {
        "position": { "x": 460, "y": 220 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "llm", "from": "driftlens_analyze" }
      ]
    },
    {
      "id": "run_memory",
      "provider": "memory_internal",
      "name": "Memory",
      "config": {
        "type": "memory_internal"
      },
      "ui": {
        "position": { "x": 640, "y": 220 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "memory", "from": "driftlens_analyze" }
      ]
    },
    {
      "id": "hydradb_driftlens",
      "provider": "db_hydradb",
      "config": {
        "profile": "default",
        "default": {
          "api_key": "${ROCKETRIDE_HYDRA_DB_API_KEY}",
          "database": "love2agents",
          "collection": "all-hjkljk",
          "max_results": 10
        },
        "parameters": {}
      },
      "ui": {
        "position": { "x": 220, "y": 220 },
        "nodeType": "default",
        "formDataValid": true
      },
      "control": [
        { "classType": "tool", "from": "driftlens_analyze" }
      ]
    },
    {
      "id": "driftlens_response",
      "provider": "response_answers",
      "name": "Return Answers",
      "config": {
        "laneName": "components"
      },
      "ui": {
        "position": { "x": 720, "y": 0 },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        { "lane": "answers", "from": "driftlens_analyze" }
      ]
    }
  ],
  "source": "driftlens_webhook",
  "project_id": "f7f748d8-9e6f-41a9-90de-57f106968b35",
  "version": 1,
  "isLocked": false,
  "snapToGrid": true,
  "snapGridSize": [10, 10],
  "docRevision": 23
}
