# --- RocketRide -------------------------------------------------------------
# The VS Code extension writes these two into .env from its settings —
# configure them there (rocketride.hostUrl + API key) rather than by hand.
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=your-rocketride-api-key

# LLM used by the llm_anthropic_1 node in drift_investigation.pipe.
# Must be prefixed ROCKETRIDE_ to be substituted into the pipeline config.
ROCKETRIDE_ANTHROPIC_KEY=your-anthropic-api-key

# --- InsForge ---------------------------------------------------------------
# Only needed for `--persist`. Link the project first:
#   npx @insforge/cli link
# INSFORGE_URL is the `oss_host` field from .insforge/project.json.
# INSFORGE_API_KEY is a full-access admin key — server-side only, never ship
# it to the frontend. The frontend uses the anon key instead.
INSFORGE_URL=https://your-appkey.us-east.insforge.app
INSFORGE_API_KEY=your-insforge-admin-api-key
